+static void piix4_asf_target_disable(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short smba = adapdata->smba;
+	u8 val;
+
+	val = inb_p(smba + PIIX4_ASF_SLAVE_EN);
+	val &= ~PIIX4_ASF_SLAVE_INTR_EN;
+	val |= PIIX4_ASF_SLAVE_RESET;
+	outb_p(val, smba + PIIX4_ASF_SLAVE_EN);
+}
+
+static void piix4_asf_select_master(struct i2c_piix4_adapdata *adapdata)
+{
+	outb_p(PIIX4_ASF_SELECT_MASTER,
+	       adapdata->smba + PIIX4_ASF_BANK_SEL);
+}
+
+static void piix4_asf_irq_mask(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short smba = adapdata->smba;
+	u8 val;
+
+	val = inb_p(smba + PIIX4_ASF_SLAVE_EN);
+	outb_p(val & ~PIIX4_ASF_SLAVE_INTR_EN,
+	       smba + PIIX4_ASF_SLAVE_EN);
+}
+
+static void piix4_asf_irq_unmask(struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short smba = adapdata->smba;
+	u8 val;
+
+	val = inb_p(smba + PIIX4_ASF_SLAVE_EN);
+	outb_p((val | PIIX4_ASF_SLAVE_INTR_EN) & ~PIIX4_ASF_SLAVE_RESET,
+	       smba + PIIX4_ASF_SLAVE_EN);
+}
+
+static void piix4_asf_windows_read_bank(
+		struct i2c_piix4_adapdata *adapdata, bool bank1,
+		u8 data[PIIX4_ASF_HOST_NOTIFY_LEN])
+{
+	unsigned short smba = adapdata->smba;
+	unsigned int i;
+
+	/* The installed Windows driver uses the literal selector table { 0, 0x10 }. */
+	outb_p(bank1 ? PIIX4_ASF_READ_BANK1 : 0,
+	       smba + PIIX4_ASF_BANK_SEL);
+	inb_p(smba + 0x02);
+	for (i = 0; i < PIIX4_ASF_HOST_NOTIFY_LEN; i++)
+		data[i] = inb_p(smba + PIIX4_ASF_INDEX);
+}
+
+/*
+ * Reproduce Smb_driver_AMDASF.sys 0x1400055e4/0x1400056fc.  Offset
+ * +0x13 is sampled exactly once.  Full banks are read oldest first and the
+ * saved full-bank bits are released in one combined write after all reads.
+ */
+static u8 piix4_asf_windows_read_banks(
+		struct i2c_piix4_adapdata *adapdata,
+		u8 frame[PIIX4_ASF_WINDOWS_MAX_FRAMES]
+			[PIIX4_ASF_HOST_NOTIFY_LEN])
+{
+	unsigned short smba = adapdata->smba;
+	u8 bank_sel = inb_p(smba + PIIX4_ASF_BANK_SEL);
+	u8 state = bank_sel & (PIIX4_ASF_BANK0_FULL |
+			       PIIX4_ASF_BANK1_FULL | PIIX4_ASF_LAST_BANK1);
+	u8 count = 0;
+
+	switch (state) {
+	case PIIX4_ASF_BANK0_FULL:
+		piix4_asf_windows_read_bank(adapdata, false, frame[count++]);
+		break;
+	case PIIX4_ASF_BANK1_FULL | PIIX4_ASF_LAST_BANK1:
+		piix4_asf_windows_read_bank(adapdata, true, frame[count++]);
+		break;
+	case PIIX4_ASF_BANK0_FULL | PIIX4_ASF_BANK1_FULL:
+		piix4_asf_windows_read_bank(adapdata, true, frame[count++]);
+		piix4_asf_windows_read_bank(adapdata, false, frame[count++]);
+		break;
+	case PIIX4_ASF_BANK0_FULL | PIIX4_ASF_BANK1_FULL |
+	     PIIX4_ASF_LAST_BANK1:
+		piix4_asf_windows_read_bank(adapdata, false, frame[count++]);
+		piix4_asf_windows_read_bank(adapdata, true, frame[count++]);
+		break;
+	case 0:
+	case PIIX4_ASF_LAST_BANK1:
+		return 0;
+	default:
+		/* Windows releases impossible nonempty states without parsing. */
+		outb_p(bank_sel & (PIIX4_ASF_BANK0_FULL |
+				     PIIX4_ASF_BANK1_FULL),
+		       smba + PIIX4_ASF_BANK_SEL);
+		return 0;
+	}
+
+	outb_p(bank_sel & (PIIX4_ASF_BANK0_FULL | PIIX4_ASF_BANK1_FULL),
+	       smba + PIIX4_ASF_BANK_SEL);
+	return count;
+}
+
+static void piix4_asf_windows_recover_target(
+		struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short smba = adapdata->smba;
+	u8 val = inb_p(smba + PIIX4_ASF_SLAVE_EN);
+
+	/* Exact 0x80 recovery ordering from Smb_driver_AMDASF.sys. */
+	outb_p(val | PIIX4_ASF_SLAVE_RESET, smba + PIIX4_ASF_SLAVE_EN);
+	outb_p(val & ~PIIX4_ASF_SLAVE_RESET, smba + PIIX4_ASF_SLAVE_EN);
+	outb_p(0x11, smba + PIIX4_ASF_LISTEN_ADDR);
+}
+
+/*
+ * Reproduce the reset/listen transition used by the Windows driver's
+ * SelfManagedIoInit path.
+ */
+static void piix4_asf_windows_restart_target(
+		struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short smba = adapdata->smba;
+	u8 val = inb_p(smba + PIIX4_ASF_SLAVE_EN);
+
+	/*
+	 * Runtime disable clears SLAVE_INTR_EN, whereas Windows arrives here with
+	 * it set by PrepareHardware.  Fold its restoration into the same two
+	 * writes so both cold start and runtime restart retain the recovered
+	 * reset-pulse -> listen-0x11 ordering.
+	 */
+	val |= PIIX4_ASF_SLAVE_INTR_EN;
+	outb_p(val | PIIX4_ASF_SLAVE_RESET, smba + PIIX4_ASF_SLAVE_EN);
+	outb_p(val & ~PIIX4_ASF_SLAVE_RESET, smba + PIIX4_ASF_SLAVE_EN);
+	outb_p(0x11, smba + PIIX4_ASF_LISTEN_ADDR);
+}
+
+/*
+ * Exact PrepareHardware target stage recovered from Smb_driver_AMDASF.sys:
+ * clear only the full banks from one saved +0x13 snapshot, save +0x15, select
+ * listen state 0x10, and perform the saved-value 0x12/0x02 enable sequence.
+ * The Linux IRQ remains disabled while this runs.  Its caller enables the IRQ
+ * and then immediately invokes the SelfManagedIoInit-equivalent restart helper.
+ */
+static void piix4_asf_windows_prepare_target(
+		struct i2c_piix4_adapdata *adapdata)
+{
+	unsigned short smba = adapdata->smba;
+	u8 bank_sel, old;
+
+	bank_sel = inb_p(smba + PIIX4_ASF_BANK_SEL);
+	outb_p(bank_sel & (PIIX4_ASF_BANK0_FULL | PIIX4_ASF_BANK1_FULL),
+	       smba + PIIX4_ASF_BANK_SEL);
+	old = inb_p(smba + PIIX4_ASF_SLAVE_EN);
+	outb_p(0x10, smba + PIIX4_ASF_LISTEN_ADDR);
+
+	outb_p(old | PIIX4_ASF_SLAVE_RESET | PIIX4_ASF_SLAVE_INTR_EN,
+	       smba + PIIX4_ASF_SLAVE_EN);
+	outb_p((old & ~PIIX4_ASF_SLAVE_RESET) | PIIX4_ASF_SLAVE_INTR_EN,
+	       smba + PIIX4_ASF_SLAVE_EN);
+}
+
+static int piix4_asf_acquire_host_semaphore(struct i2c_adapter *adap)
+{
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+	unsigned short smba = adapdata->smba;
+	int timeout = 0;
+	u8 value;
+
+	outb_p(PIIX4_ASF_HOST_SEMAPHORE, smba + PIIX4_ASF_SEMAPHORE);
+	while (++timeout < MAX_TIMEOUT) {
+		value = inb_p(smba + PIIX4_ASF_SEMAPHORE);
+		if (value & PIIX4_ASF_HOST_SEMAPHORE)
+			return 0;
+		usleep_range(250, 500);
+	}
+
+	/* Cancel a timed-out host request before returning to the caller. */
+	outb_p(PIIX4_ASF_CLEAR_HOST_SEMAPHORE,
+	       smba + PIIX4_ASF_SEMAPHORE);
+	dev_err_ratelimited(&adap->dev,
+			    "could not acquire ASF host semaphore\n");
+	return -EBUSY;
+}
+
+static void piix4_asf_release_host_semaphore(struct i2c_piix4_adapdata *adapdata)
+{
+	outb_p(PIIX4_ASF_CLEAR_HOST_SEMAPHORE,
+	       adapdata->smba + PIIX4_ASF_SEMAPHORE);
+}
+
+static bool piix4_asf_storm(struct i2c_adapter *adap)
+{
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+	unsigned long now = jiffies;
+
+	if (time_after(now, adapdata->irq_window + HZ)) {
+		adapdata->irq_window = now;
+		adapdata->irq_window_count = 0;
+	}
+
+	if (++adapdata->irq_window_count <=
+	    PIIX4_ASF_WINDOWS_POLICY_STORM_LIMIT)
+		return false;
+
+	adapdata->host_notify_stormed = true;
+	WRITE_ONCE(adapdata->host_notify_ready, false);
+	piix4_asf_target_disable(adapdata);
+	dev_err(&adap->dev,
+		"Host Notify disabled after interrupt storm (%u IRQs/window); receiver remains disabled until explicitly re-armed\n",
+		adapdata->irq_window_count);
+	return true;
+}
+
+static irqreturn_t piix4_asf_irq(int irq, void *data)
+{
+	struct i2c_adapter *adap = data;
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+	unsigned short smba = adapdata->smba;
+	u8 asf_status, count;
+	irqreturn_t ret;
+
+	spin_lock(&adapdata->asf_lock);
+		/*
+		 * Windows gives recovery bit 0x80 priority and performs no FIFO
+		 * work in that invocation.  A shared IRQ is ours only for 0x80 or
+		 * the literal SlaveIntr bit 0x40; bank fullness alone is not enough.
+		 * Do not W1C host +0x00 here: ENABLE_INT9 is zero and Linux's polled
+		 * master transaction path owns that completion status.
+		 */
+		asf_status = inb_p(smba + PIIX4_ASF_STATUS);
+		if (asf_status & BIT(7)) {
+			if (!piix4_asf_storm(adap))
+				piix4_asf_windows_recover_target(adapdata);
+			ret = IRQ_HANDLED;
+			goto out_unlock;
+		}
+		if (!(asf_status & PIIX4_ASF_SLAVE_INTR)) {
+			ret = IRQ_NONE;
+			goto out_unlock;
+		}
+
+		outb_p(PIIX4_ASF_SLAVE_INTR, smba + PIIX4_ASF_STATUS);
+		if (piix4_asf_storm(adap)) {
+			ret = IRQ_HANDLED;
+			goto out_unlock;
+		}
+
+		/* Windows acknowledges SlaveIntr, then rejects target-reset state. */
+		if (inb_p(smba + PIIX4_ASF_SLAVE_EN) &
+		    PIIX4_ASF_SLAVE_RESET) {
+			ret = IRQ_HANDLED;
+			goto out_unlock;
+		}
+
+		/* IRQF_ONESHOT must keep this handoff single-producer/single-consumer. */
+		if (WARN_ON_ONCE(adapdata->staged_count)) {
+			WRITE_ONCE(adapdata->host_notify_ready, false);
+			adapdata->host_notify_stormed = true;
+			piix4_asf_target_disable(adapdata);
+			ret = IRQ_HANDLED;
+			goto out_unlock;
+		}
+
+		count = piix4_asf_windows_read_banks(
+			adapdata, adapdata->staged_frame);
+		if (!count) {
+			ret = IRQ_HANDLED;
+			goto out_unlock;
+		}
+		/* Publish only after both hardware reads and the combined release. */
+		adapdata->staged_count = count;
+		ret = IRQ_WAKE_THREAD;
+		goto out_unlock;
+out_unlock:
+	spin_unlock(&adapdata->asf_lock);
+	return ret;
+}
+
+static void piix4_asf_process_frame(struct i2c_adapter *adap,
+				    const u8 data[PIIX4_ASF_HOST_NOTIFY_LEN])
+{
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+
+	if (data[0] == 0x10 && !(data[1] & 1) &&
+	    (data[1] >> 1) == 0x2c &&
+	    READ_ONCE(adapdata->host_notify_ready))
+		i2c_handle_smbus_host_notify(adap, data[1] >> 1);
+}
+
+static irqreturn_t piix4_asf_irq_thread(int irq, void *data)
+{
+	struct i2c_adapter *adap = data;
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+	unsigned long flags;
+	u8 frame[PIIX4_ASF_WINDOWS_MAX_FRAMES]
+		[PIIX4_ASF_HOST_NOTIFY_LEN];
+	u8 count, i;
+
+	/* IRQF_ONESHOT keeps the hardware source masked through this copy. */
+	spin_lock_irqsave(&adapdata->asf_lock, flags);
+	count = adapdata->staged_count;
+	if (WARN_ON_ONCE(count > PIIX4_ASF_WINDOWS_MAX_FRAMES))
+		count = 0;
+	memcpy(frame, adapdata->staged_frame, sizeof(frame));
+	adapdata->staged_count = 0;
+	spin_unlock_irqrestore(&adapdata->asf_lock, flags);
+
+	for (i = 0; i < count; i++)
+		piix4_asf_process_frame(adap, frame[i]);
+	return IRQ_HANDLED;
+}
+
+static int piix4_asf_pm_enable(struct device *dev,
+			       struct i2c_piix4_adapdata *adapdata)
+{
+	struct sb800_mmio_cfg *cfg = &adapdata->mmio_cfg;
+	u32 decode;
+	u8 control, disabled_control;
+	int ret;
+
+	ret = piix4_sb800_region_request(dev, cfg);
+	if (ret)
+		return ret;
+
+	/* Initialization sequence observed in Smb_driver_AMDASF.sys. */
+	decode = ioread32(cfg->addr + 0x00);
+	control = ioread8(cfg->addr + 0x02);
+	adapdata->pm_decode_saved = decode;
+	adapdata->pm_control_saved = control;
+	disabled_control = control & ~0x05;
+	iowrite32(decode | BIT(4), cfg->addr + 0x00);
+	iowrite8(disabled_control, cfg->addr + 0x02);
+	if (ioread8(cfg->addr + 0x02) != disabled_control) {
+		iowrite8(control, cfg->addr + 0x02);
+		iowrite32(decode, cfg->addr + 0x00);
+		piix4_sb800_region_release(dev, cfg);
+		dev_err(dev, "ASF setup transition failed; original state restored\n");
+		return -EIO;
+	}
+	piix4_sb800_region_release(dev, cfg);
+	return 0;
+}
+
+static int piix4_asf_pm_enable_transfer(struct i2c_adapter *adap,
+					 struct i2c_piix4_adapdata *adapdata)
+{
+	u8 control, semaphore;
+
+	if (!adapdata->host_notify)
+		return 0;
+	semaphore = inb_p(adapdata->smba + PIIX4_ASF_SEMAPHORE);
+	if (!(semaphore & PIIX4_ASF_HOST_SEMAPHORE)) {
+		dev_err(&adap->dev,
+			"refusing setup-byte RMW without verified ASF host semaphore ownership (semaphore=%02x)\n",
+			semaphore);
+		return -EACCES;
+	}
+
+	control = ioread8(adapdata->mmio_cfg.addr + 0x02);
+	iowrite8(control | 0x05, adapdata->mmio_cfg.addr + 0x02);
+	return 0;
+}
+
+/*
+ * Windows brackets its normal 07 -> 06 transition between the master-status
+ * completion acknowledgment (vendor RVA 547C) and the following ASF-status
+ * read (RVA 54DD), only 5.5--10.6 us later in synchronized captures.  Run the
+ * Clear at the equivalent Linux boundary, before response extraction or
+ * any target-status handling, rather than after the complete SMBus access has
+ * unwound to piix4_access_host_notify().
+ */
+static void piix4_asf_pm_ack_complete(
+		struct i2c_adapter *adap,
+		struct i2c_piix4_adapdata *adapdata)
+{
+	u8 control;
+
+	if (!adapdata->host_notify)
+		return;
+	control = ioread8(adapdata->mmio_cfg.addr + 0x02);
+	if (control & BIT(0))
+		iowrite8(control & ~BIT(0), adapdata->mmio_cfg.addr + 0x02);
