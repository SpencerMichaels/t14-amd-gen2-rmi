+static void piix4_asf_pm_disable(struct device *dev,
+				 struct i2c_piix4_adapdata *adapdata)
+{
+	struct sb800_mmio_cfg *cfg = &adapdata->mmio_cfg;
+
+	if (!piix4_sb800_region_request(dev, cfg)) {
+		iowrite8(adapdata->pm_control_saved, cfg->addr + 0x02);
+		iowrite32(adapdata->pm_decode_saved, cfg->addr + 0x00);
+		piix4_sb800_region_release(dev, cfg);
+	}
+}
