+static int piix4_smb0001_irq(unsigned short smba)
+{
+	struct acpi_device *adev;
+	struct resource_entry *entry;
+	LIST_HEAD(resources);
+	bool found_io = false;
+	int irq = -ENODEV;
+	int ret;
+
+	adev = acpi_dev_get_first_match_dev("SMB0001", NULL, -1);
+	if (!adev)
+		return -ENODEV;
+
+	ret = acpi_dev_get_resources(adev, &resources, NULL, NULL);
+	if (ret < 0)
+		goto out_put;
+
+	resource_list_for_each_entry(entry, &resources) {
+		struct resource *res = entry->res;
+
+		if (resource_type(res) == IORESOURCE_IO &&
+		    res->start == smba && resource_size(res) >= PIIX4_ASF_IO_SIZE)
+			found_io = true;
+		else if (resource_type(res) == IORESOURCE_IRQ &&
+			 resource_size(res) == 1) {
+			unsigned long trigger_mask = IORESOURCE_IRQ_HIGHEDGE |
+				IORESOURCE_IRQ_LOWEDGE | IORESOURCE_IRQ_HIGHLEVEL |
+				IORESOURCE_IRQ_LOWLEVEL;
+
+			if ((res->flags & trigger_mask) != IORESOURCE_IRQ_LOWLEVEL ||
+			    !(res->flags & IORESOURCE_IRQ_SHAREABLE)) {
+				irq = -EINVAL;
+				break;
+			}
+			irq = res->start;
+		}
+	}
+
+	acpi_dev_free_resource_list(&resources);
+	if (!found_io)
+		irq = -ENODEV;
+out_put:
+	acpi_dev_put(adev);
+	return ret < 0 ? ret : irq;
+}
