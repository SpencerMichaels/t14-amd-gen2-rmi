+static int piix4_asf_prepare(struct pci_dev *pdev, struct i2c_adapter *adap,
+			     struct i2c_piix4_adapdata *adapdata, int irq)
+{
+	unsigned long flags;
+	int ret;
+
+	if (irq != 7) {
+		dev_err(&pdev->dev,
+			"Host Notify is restricted to the recovered IRQ 7 topology (got IRQ %d)\n",
+			irq);
+		return -EINVAL;
+	}
+
+	if (!request_region(adapdata->smba + SMBIOSIZE,
+			    PIIX4_ASF_IO_SIZE - SMBIOSIZE,
+			    "piix4_smbus_host_notify"))
+		return -EBUSY;
+	adapdata->irq = irq;
+	adapdata->irq_window = jiffies;
+	spin_lock_init(&adapdata->asf_lock);
+
+	ret = piix4_asf_pm_enable(&pdev->dev, adapdata);
+	if (ret)
+		goto err_region;
+
+	ret = devm_request_threaded_irq(&pdev->dev, irq, piix4_asf_irq,
+					piix4_asf_irq_thread,
+					IRQF_ONESHOT | IRQF_TRIGGER_LOW |
+					IRQF_NO_AUTOEN,
+					"piix4_smbus_host_notify", adap);
+	if (ret)
+		goto err_pm;
+
+	spin_lock_irqsave(&adapdata->asf_lock, flags);
+	piix4_asf_windows_prepare_target(adapdata);
+	enable_irq(irq);
+	piix4_asf_windows_restart_target(adapdata);
+	spin_unlock_irqrestore(&adapdata->asf_lock, flags);
+
+	adapdata->host_notify = true;
+	return 0;
+
+err_pm:
+	piix4_asf_pm_disable(&pdev->dev, adapdata);
+err_region:
+	release_region(adapdata->smba + SMBIOSIZE,
+		       PIIX4_ASF_IO_SIZE - SMBIOSIZE);
+	return ret;
+}
+
+static void piix4_asf_quiesce(struct i2c_adapter *adap)
+{
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+	unsigned long flags;
+
+	if (!adapdata->host_notify)
+		return;
+
+	WRITE_ONCE(adapdata->host_notify_ready, false);
+	spin_lock_irqsave(&adapdata->asf_lock, flags);
+	piix4_asf_irq_mask(adapdata);
+	spin_unlock_irqrestore(&adapdata->asf_lock, flags);
+	disable_irq(adapdata->irq);
+	spin_lock_irqsave(&adapdata->asf_lock, flags);
+	piix4_asf_target_disable(adapdata);
+	spin_unlock_irqrestore(&adapdata->asf_lock, flags);
+}
+
+static void piix4_asf_finish(struct device *dev,
+			     struct i2c_adapter *adap,
+			     struct i2c_piix4_adapdata *adapdata)
+{
+	if (adapdata->host_notify) {
+		devm_free_irq(dev, adapdata->irq, adap);
+		adapdata->host_notify = false;
+		piix4_asf_pm_disable(dev, adapdata);
+		release_region(adapdata->smba + SMBIOSIZE,
+			       PIIX4_ASF_IO_SIZE - SMBIOSIZE);
+	}
+}
