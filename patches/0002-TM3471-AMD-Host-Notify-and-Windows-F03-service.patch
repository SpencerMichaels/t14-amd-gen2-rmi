+static s32 piix4_access_host_notify(struct i2c_adapter *adap, u16 addr,
+				    unsigned short flags, char read_write,
+				    u8 command, int size,
+				    union i2c_smbus_data *data)
+{
+	struct i2c_piix4_adapdata *adapdata = i2c_get_adapdata(adap);
+	unsigned long irqflags;
+	s32 ret;
+
+	ret = piix4_asf_acquire_host_semaphore(adap);
+	if (ret)
+		return ret;
+	/* Map the shared PM region before IRQ synchronization can block. */
+	ret = piix4_sb800_region_request(&adap->dev, &adapdata->mmio_cfg);
+	if (ret) {
+		piix4_asf_release_host_semaphore(adapdata);
+		return ret;
+	}
+
+	/*
+	 * The master engine and Host Notify FIFO share registers.  Stop the
+	 * level-triggered source before disable_irq() waits for the threaded
+	 * handler.  Reversing this order can livelock when the touchpad keeps
+	 * the source asserted with empty notifications.
+	 */
+	spin_lock_irqsave(&adapdata->asf_lock, irqflags);
+	piix4_asf_irq_mask(adapdata);
+	spin_unlock_irqrestore(&adapdata->asf_lock, irqflags);
+	disable_irq(adapdata->irq);
+	piix4_asf_select_master(adapdata);
+
+	ret = piix4_access(adap, addr, flags, read_write, command, size, data);
