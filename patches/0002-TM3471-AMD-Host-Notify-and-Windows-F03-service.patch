+	spin_lock_irqsave(&adapdata->asf_lock, irqflags);
+	if (ret && ret != -EIO && ret != -ENXIO) {
+		WRITE_ONCE(adapdata->host_notify_ready, false);
+		adapdata->host_notify_stormed = true;
+		piix4_asf_target_disable(adapdata);
+	} else if (!adapdata->host_notify_stormed) {
+		piix4_asf_irq_unmask(adapdata);
+	}
+	spin_unlock_irqrestore(&adapdata->asf_lock, irqflags);
+	enable_irq(adapdata->irq);
+	piix4_sb800_region_release(&adap->dev, &adapdata->mmio_cfg);
+	piix4_asf_release_host_semaphore(adapdata);
+	return ret;
 }
 
