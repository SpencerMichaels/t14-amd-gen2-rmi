From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Spencer Michaels <spencer@spencermichaels.net>
Date: Thu, 8 Oct 2026 15:30:00 -0700
Subject: [PATCH 3/3] Input: rmi4 - keep T14 Gen 2a TM3471 out of automatic doze

On the ThinkPad T14 Gen 2a, system resume can leave the TM3471 sensor in a
state in which touches that start from automatic doze report distorted early
contact geometry: two-finger separation grows from roughly 6-8 mm to 17-20 mm
within the first 60 ms, which libinput interprets as a pinch gesture.

The state survives driver reloads and an F54 force calibration, and is only
expressed while automatic doze is allowed.  Setting the F01 NoSleep bit while
the system is awake hides it immediately; clearing the bit brings the false
pinches back.  System suspend still clears NoSleep and requests sensor sleep
as before, so this does not change suspend power.

Keep NoSleep set on the exact TM3471-030 firmware 3942087 configuration by
default.  rmi_core.tm3471_nosleep=0 restores automatic doze at boot, and the
rmi4 device attribute tm3471_nosleep toggles it at runtime for testing.

diff --git a/drivers/input/rmi4/rmi_f01.c b/drivers/input/rmi4/rmi_f01.c
index 9961fd3..02156e3 100644
--- a/drivers/input/rmi4/rmi_f01.c
+++ b/drivers/input/rmi4/rmi_f01.c
@@ -5,6 +5,8 @@
  */
 
 #include <linux/kernel.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/rmi.h>
 #include <linux/slab.h>
 #include <linux/uaccess.h>
@@ -17,6 +19,11 @@
 
 #define RMI_DATE_CODE_LENGTH      3
 
+static bool tm3471_nosleep = true;
+module_param(tm3471_nosleep, bool, 0444);
+MODULE_PARM_DESC(tm3471_nosleep,
+		 "Keep the T14 Gen 2a TM3471 out of automatic doze while the system is awake (default: Y)");
+
 #define PRODUCT_ID_OFFSET 0x10
 #define PRODUCT_INFO_OFFSET 0x1E
 
@@ -130,10 +137,33 @@ struct f01_data {
 
 	bool suspended;
 	bool old_nosleep;
+	bool tm3471_nosleep;
+	/* Serializes device_control.ctrl0 updates with the sysfs toggle. */
+	struct mutex ctrl0_lock;
 
 	unsigned int num_of_irq_regs;
 };
 
+/*
+ * On the T14 Gen 2a TM3471, system resume can leave the sensor in a state in
+ * which touches starting from automatic doze report distorted early contact
+ * geometry, producing false pinch gestures. Keeping the sensor out of doze
+ * while the system is awake hides that state. System suspend still clears
+ * NoSleep and requests sensor sleep as usual.
+ */
+static void rmi_f01_tm3471_apply_nosleep(struct rmi_function *fn,
+					 struct f01_data *f01)
+{
+	if ((f01->device_control.ctrl0 & RMI_F01_CTRL0_SLEEP_MODE_MASK) !=
+	    RMI_SLEEP_MODE_NORMAL || !rmi_is_tm3471_030_3942087(fn->rmi_dev))
+		return;
+
+	if (f01->tm3471_nosleep)
+		f01->device_control.ctrl0 |= RMI_F01_CTRL0_NOSLEEP_BIT;
+	else
+		f01->device_control.ctrl0 &= ~RMI_F01_CTRL0_NOSLEEP_BIT;
+}
+
 static int rmi_f01_read_properties(struct rmi_device *rmi_dev,
 				   u16 query_base_addr,
 				   struct f01_basic_properties *props)
@@ -340,12 +370,56 @@ static ssize_t rmi_driver_package_id_show(struct device *dev,
 
 static DEVICE_ATTR(package_id, 0444, rmi_driver_package_id_show, NULL);
 
+static ssize_t tm3471_nosleep_show(struct device *dev,
+				   struct device_attribute *dattr, char *buf)
+{
+	struct rmi_driver_data *data = dev_get_drvdata(dev);
+	struct f01_data *f01 = dev_get_drvdata(&data->f01_container->dev);
+
+	return sysfs_emit(buf, "%d\n", f01->tm3471_nosleep);
+}
+
+static ssize_t tm3471_nosleep_store(struct device *dev,
+				    struct device_attribute *dattr,
+				    const char *buf, size_t count)
+{
+	struct rmi_driver_data *data = dev_get_drvdata(dev);
+	struct rmi_function *fn = data->f01_container;
+	struct f01_data *f01 = dev_get_drvdata(&fn->dev);
+	bool nosleep;
+	int error;
+
+	error = kstrtobool(buf, &nosleep);
+	if (error)
+		return error;
+	if (!rmi_is_tm3471_030_3942087(fn->rmi_dev))
+		return -ENODEV;
+
+	mutex_lock(&f01->ctrl0_lock);
+	f01->tm3471_nosleep = nosleep;
+	rmi_f01_tm3471_apply_nosleep(fn, f01);
+	if ((f01->device_control.ctrl0 & RMI_F01_CTRL0_SLEEP_MODE_MASK) ==
+	    RMI_SLEEP_MODE_NORMAL)
+		error = rmi_write(fn->rmi_dev, fn->fd.control_base_addr,
+				  f01->device_control.ctrl0);
+	mutex_unlock(&f01->ctrl0_lock);
+	if (error)
+		return error;
+
+	dev_info(&fn->dev, "TM3471 NoSleep %s\n",
+		 nosleep ? "enabled" : "disabled");
+	return count;
+}
+
+static DEVICE_ATTR_RW(tm3471_nosleep);
+
 static struct attribute *rmi_f01_attrs[] = {
 	&dev_attr_manufacturer_id.attr,
 	&dev_attr_date_of_manufacture.attr,
 	&dev_attr_product_id.attr,
 	&dev_attr_firmware_id.attr,
 	&dev_attr_package_id.attr,
+	&dev_attr_tm3471_nosleep.attr,
 	NULL
 };
 
@@ -418,6 +492,9 @@ static int rmi_f01_probe(struct rmi_function *fn)
 	if (!f01)
 		return -ENOMEM;
 
+	mutex_init(&f01->ctrl0_lock);
+	f01->tm3471_nosleep = tm3471_nosleep;
+
 	f01->num_of_irq_regs = driver_data->num_of_irq_regs;
 
 	/*
@@ -603,8 +680,11 @@ static int rmi_f01_config(struct rmi_function *fn)
 	struct f01_data *f01 = dev_get_drvdata(&fn->dev);
 	int error;
 
+	mutex_lock(&f01->ctrl0_lock);
+	rmi_f01_tm3471_apply_nosleep(fn, f01);
 	error = rmi_write(fn->rmi_dev, fn->fd.control_base_addr,
 			  f01->device_control.ctrl0);
+	mutex_unlock(&f01->ctrl0_lock);
 	if (error) {
 		dev_err(&fn->dev,
 			"Failed to write device_control register: %d\n", error);
@@ -650,6 +730,7 @@ static int rmi_f01_suspend(struct rmi_function *fn)
 	struct f01_data *f01 = dev_get_drvdata(&fn->dev);
 	int error;
 
+	mutex_lock(&f01->ctrl0_lock);
 	f01->old_nosleep =
 		f01->device_control.ctrl0 & RMI_F01_CTRL0_NOSLEEP_BIT;
 	f01->device_control.ctrl0 &= ~RMI_F01_CTRL0_NOSLEEP_BIT;
@@ -668,10 +749,10 @@ static int rmi_f01_suspend(struct rmi_function *fn)
 			f01->device_control.ctrl0 |= RMI_F01_CTRL0_NOSLEEP_BIT;
 		f01->device_control.ctrl0 &= ~RMI_F01_CTRL0_SLEEP_MODE_MASK;
 		f01->device_control.ctrl0 |= RMI_SLEEP_MODE_NORMAL;
-		return error;
 	}
+	mutex_unlock(&f01->ctrl0_lock);
 
-	return 0;
+	return error;
 }
 
 static int rmi_f01_resume(struct rmi_function *fn)
@@ -679,14 +760,17 @@ static int rmi_f01_resume(struct rmi_function *fn)
 	struct f01_data *f01 = dev_get_drvdata(&fn->dev);
 	int error;
 
+	mutex_lock(&f01->ctrl0_lock);
 	if (f01->old_nosleep)
 		f01->device_control.ctrl0 |= RMI_F01_CTRL0_NOSLEEP_BIT;
 
 	f01->device_control.ctrl0 &= ~RMI_F01_CTRL0_SLEEP_MODE_MASK;
 	f01->device_control.ctrl0 |= RMI_SLEEP_MODE_NORMAL;
 
+	rmi_f01_tm3471_apply_nosleep(fn, f01);
 	error = rmi_write(fn->rmi_dev, fn->fd.control_base_addr,
 			  f01->device_control.ctrl0);
+	mutex_unlock(&f01->ctrl0_lock);
 	if (error) {
 		dev_err(&fn->dev,
 			"Failed to restore normal operation: %d.\n", error);
